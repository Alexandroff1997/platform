{
  "info": {
    "name": "Account - Auth",
    "description": "Самодостаточные сценарии регистрации и входа. Запускайте коллекцию в Collection Runner против локального API; email генерируется заново для каждого запуска.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "password",
      "value": "PostmanDemoPass123!",
      "type": "string"
    },
    {
      "key": "userEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "teacherEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "unknownEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentSub",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Регистрация: роль Student по умолчанию",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Первый запрос каждого запуска создаёт новый email и сохраняет его для следующих сценариев."
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);",
              "const email = 'postman-' + suffix + '@example.test';",
              "pm.collectionVariables.set('userEmail', email);",
              "pm.collectionVariables.set('teacherEmail', 'teacher-' + email);",
              "pm.collectionVariables.set('unknownEmail', 'unknown-' + email);",
              "pm.collectionVariables.set('accessToken', '');",
              "pm.collectionVariables.set('studentSub', '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.test('registration response contract', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.email).to.eql(pm.collectionVariables.get('userEmail'));",
              "  pm.expect(body.message).to.eql('User successfully created');",
              "  pm.expect(Object.keys(body).sort()).to.eql(['email', 'message']);",
              "});"
            ]
          }
        }
      ]
    },
