    {
      "name": "Вход: Student и сохранение accessToken",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('login returns an access token', function () {",
              "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
              "  pm.expect(Object.keys(body)).to.eql(['accessToken']);",
              "});",
              "const parts = body.accessToken.split('.');",
              "pm.test('JWT has three parts', function () { pm.expect(parts).to.have.lengthOf(3); });",
              "let header;",
              "let claims;",
              "try {",
              "  const decodeBase64Url = function (value) { const base64 = value.replace(/-/g, '+').replace(/_/g, '/'); return atob(base64 + '='.repeat((4 - base64.length % 4) % 4)); };",
              "  header = JSON.parse(decodeBase64Url(parts[0]));",
              "  claims = JSON.parse(decodeBase64Url(parts[1]));",
              "} catch (e) { throw new Error('JWT header or payload is not valid base64url JSON'); }",
              "pm.test('JWT uses HS256', function () { pm.expect(header.alg).to.eql('HS256'); });",
              "pm.test('JWT has Student claims and a 3600 second lifetime', function () {",
              "  pm.expect(claims.sub).to.be.a('string').and.not.empty;",
              "  pm.expect(claims.email).to.eql(pm.collectionVariables.get('userEmail'));",
              "  pm.expect(claims.role).to.eql('Student');",
              "  pm.expect(claims.iat).to.be.a('number');",
              "  pm.expect(claims.exp - claims.iat).to.eql(3600);",
              "});",
              "pm.collectionVariables.set('studentSub', claims.sub);",
              "pm.collectionVariables.set('accessToken', body.accessToken);"
            ]
          }
        }
      ]
    },
