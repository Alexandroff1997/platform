{
  "name": "platform-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["platform"],
  "targets": {
    "e2e": {
      "command": "jest --passWithNoTests",
