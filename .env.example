# Локальный PostgreSQL из compose.yaml (корень репозитория)
DATABASE_URL=postgresql://account:account_local@127.0.0.1:5432/account

# Тестовый пользователь для `npm run db:seed` — только локально;
SEED_USER_EMAIL=test@example.com
SEED_USER_PASSWORD=test

# JWT: сгенерируйте секрет командой из README и сохраните только в .env
JWT_SECRET="example_jwt_secret"
